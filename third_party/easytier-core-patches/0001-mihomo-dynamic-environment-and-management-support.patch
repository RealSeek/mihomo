+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub(crate) struct WasiEnvironmentUpdate {
+    pub version: u32,
+    pub revision: u64,
+    pub environment: HostConnectorEnvironmentSnapshot,
+}
+
+impl WasiEnvironmentUpdate {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        if self.version != crate::wasi::abi::ENVIRONMENT_UPDATE_VERSION {
+            anyhow::bail!("unsupported host environment update version: {}", self.version);
+        }
+        if self.revision == 0 {
+            anyhow::bail!("host environment update revision must be non-zero");
+        }
+        if self.environment.public_ipv6.is_some_and(|ip| ip.to_ipv4_mapped().is_some())
+            || self.environment.interface_ipv6s.iter().any(|ip| ip.to_ipv4_mapped().is_some())
+            || self.environment.preferred_ipv6_sources.iter().any(|source| source.ip.to_ipv4_mapped().is_some())
+        {
+            anyhow::bail!("host environment IPv6 observations must not contain IPv4-mapped addresses");
+        }
+        Ok(())
+    }
+}
