+
+impl From<&HostConnectorEnvironmentSnapshot> for HostConnectorEnvironmentDynamic {
+    fn from(snapshot: &HostConnectorEnvironmentSnapshot) -> Self {
+        Self {
+            public_ipv4: snapshot.public_ipv4,
+            interface_ipv4s: snapshot.interface_ipv4s.clone(),
+            public_ipv6: snapshot.public_ipv6,
+            interface_ipv6s: snapshot.interface_ipv6s.clone(),
+            local_ips: snapshot.local_ips.clone(),
+            preferred_ipv6_sources: snapshot.preferred_ipv6_sources.clone(),
