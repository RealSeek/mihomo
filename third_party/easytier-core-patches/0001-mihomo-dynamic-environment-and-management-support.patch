+    #[tokio::test]
+    async fn shared_environment_updates_existing_and_later_hosts_without_changing_declarations() {
+        let state = Arc::new(HostConnectorEnvironmentState::default());
+        let original = snapshot();
+        let make_runtime = || {
+            HostConnectorRuntime::new(
+                HostSocketRuntime::new(),
+                Arc::new(UnsupportedBackend::default()),
+                original.clone(),
+                Arc::new(TestEnvironmentIo::default()),
+            )
+            .with_environment_state(state.clone())
+        };
+        let first = Arc::new(make_runtime());
+        let host = ConnectorHostAdapter::new(first.clone(), first.clone());
+        let context = SocketContext::default();
+        let initial = DirectConnectorHost::collect_ip_addrs(&host, &context).await;
+        assert_eq!(
+            initial.interface_ipv4s,
+            vec![Ipv4Addr::new(192, 0, 2, 1).into()]
+        );
+
+        let replacement = HostConnectorEnvironmentSnapshot {
+            public_ipv4: Some("198.51.100.2".parse().unwrap()),
+            interface_ipv4s: vec!["192.0.2.2".parse().unwrap()],
+            public_ipv6: Some("2001:db8::3".parse().unwrap()),
+            interface_ipv6s: vec!["2001:db8::4".parse().unwrap()],
+            mapped_listeners: vec!["tcp://198.51.100.2:22020".parse().unwrap()],
+            local_ips: vec!["192.0.2.2".parse().unwrap()],
+            protected_tcp_ports: vec![22020],
+            preferred_ipv6_sources: vec![PreferredIpv6Source {
+                ip: "2001:db8::4".parse().unwrap(),
+                ifindex: 9,
+            }],
+        };
+        let revision = u64::from(u32::MAX) + 1;
+        assert!(state.update(revision, &replacement));
+        assert!(!state.update(revision, &original));
+        assert!(!state.update(revision - 1, &original));
+        let later = make_runtime();
+        assert_eq!(state.revision(), revision);
+        let updated = DirectConnectorHost::collect_ip_addrs(&host, &context).await;
+        assert_eq!(updated, later.collect_ip_addrs(&context).await);
+        assert_eq!(
+            updated,
+            HostConnectorEnvironmentDynamic::from(&replacement).ip_list()
+        );
+        assert!(!DirectConnectorHost::is_local_ip(
+            &host,
+            &"192.0.2.1".parse().unwrap()
+        ));
+        assert!(DirectConnectorHost::is_local_ip(
+            &host,
+            &"192.0.2.2".parse().unwrap()
+        ));
+        assert_eq!(
+            DirectConnectorHost::preferred_ipv6_source(
+                &host,
+                "2001:db8::4".parse().unwrap(),
+                context.clone()
+            )
+            .await,
+            replacement.preferred_ipv6_sources.first().copied()
+        );
+        assert_eq!(
+            DirectConnectorHost::preferred_ipv6_source(
+                &host,
+                "2001:db8::2".parse().unwrap(),
+                context
+            )
+            .await,
+            None
+        );
+        assert_eq!(
+            DirectConnectorHost::mapped_listeners(&host),
+            original.mapped_listeners
+        );
+        assert_eq!(
+            first.environment.protected_tcp_ports,
+            original.protected_tcp_ports
+        );
+        assert_eq!(
+            later.environment.protected_tcp_ports,
+            original.protected_tcp_ports
+        );
+    }
 }
