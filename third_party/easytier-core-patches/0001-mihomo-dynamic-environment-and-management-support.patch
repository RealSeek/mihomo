+    }
+}
+
+#[derive(Debug, Default)]
+struct HostConnectorEnvironmentVersion {
+    initialized: bool,
+    revision: u64,
+    dynamic: HostConnectorEnvironmentDynamic,
+}
+
+/// Process-wide host facts shared by every static and Web-managed instance.
+/// Listener mappings and protected ports remain instance declarations.
+#[derive(Debug, Default)]
+pub struct HostConnectorEnvironmentState {
+    value: RwLock<HostConnectorEnvironmentVersion>,
+}
+
+impl HostConnectorEnvironmentState {
+    pub fn initialize(&self, snapshot: &HostConnectorEnvironmentSnapshot) {
+        let mut value = self.value.write();
+        if !value.initialized {
+            value.dynamic = snapshot.into();
+            value.initialized = true;
+        }
+    }
+
+    pub fn update(&self, revision: u64, snapshot: &HostConnectorEnvironmentSnapshot) -> bool {
+        let mut value = self.value.write();
+        if revision <= value.revision {
+            return false;
+        }
+        value.dynamic = snapshot.into();
+        value.revision = revision;
+        value.initialized = true;
+        true
+    }
+
+    pub fn revision(&self) -> u64 {
+        self.value.read().revision
+    }
+}
