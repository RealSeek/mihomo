diff --git a/easytier-core/src/connectivity/protocol/quic.rs b/easytier-core/src/connectivity/protocol/quic.rs
new file mode 100644
index 0000000..b871158
--- /dev/null
+++ b/easytier-core/src/connectivity/protocol/quic.rs
@@ -0,0 +1,218 @@
+//! EasyTier QUIC client and listener protocol over host-backed UDP sessions.
+
+use std::{net::SocketAddr, sync::Arc, time::Duration};
+
+use anyhow::Context;
+use quinn::{AsyncUdpSocket, Connecting, Connection, ConnectionError, Endpoint, Incoming};
+use tokio::{
+    sync::{OwnedSemaphorePermit, Semaphore, mpsc},
+    task::JoinSet,
+};
+use tokio_util::task::AbortOnDropHandle;
+use url::Url;
+
+use crate::{
+    connectivity::transport::{ConnectedTransport, ConnectedUdpSession},
+    foundation::time::timeout,
+    proto::common::TunnelInfo,
+    socket::udp::UdpSession,
+    tunnel::{
+        Tunnel, TunnelError,
+        framed::{FramedReader, FramedWriter},
+        mihomo_quic::{CoreQuicRuntime, client_config, endpoint_config, etq1_client_config, server_config},
+        mihomo_quic_session::QuicUdpSessionSocket,
+        wrapper::TunnelWrapper,
+    },
+};
+
+use super::{
+    ClientProtocolUpgrader, ServerProtocolAdmission, ServerProtocolUpgrade,
+    ServerProtocolUpgrader, ServerTunnelAcceptor,
+};
+
+pub struct QuicProtocol;
+
+struct ConnectionGuard {
+    connection: Connection,
+    _endpoint: Endpoint,
+}
+
+impl Drop for ConnectionGuard {
+    fn drop(&mut self) {
+        self.connection.close(0u32.into(), b"done");
+    }
+}
+
+fn make_tunnel(
+    endpoint: Endpoint,
+    connection: Connection,
+    writer: quinn::SendStream,
+    reader: quinn::RecvStream,
+    local_url: Url,
+    remote_url: Url,
+    max_packet_size: usize,
+) -> anyhow::Result<Box<dyn Tunnel>> {
+    let resolved = format!("quic://{}", connection.remote_address()).parse::<Url>()?;
+    let guard = Arc::new(ConnectionGuard { connection, _endpoint: endpoint });
+    Ok(Box::new(TunnelWrapper::new(
+        FramedReader::new_with_associate_data(reader, max_packet_size, Some(Box::new(guard.clone()))),
+        FramedWriter::new_with_associate_data(writer, Some(Box::new(guard))),
+        Some(TunnelInfo {
+            tunnel_type: "quic".to_owned(), local_addr: Some(local_url.into()),
+            remote_addr: Some(remote_url.into()), resolved_remote_addr: Some(resolved.into()),
+        }),
+    )))
+}
+
+async fn connect(
+    session: ConnectedUdpSession,
+    remote_url: Url,
+) -> anyhow::Result<Box<dyn Tunnel>> {
+    let socket = Arc::new(QuicUdpSessionSocket::new(session)?);
+    let local_url = format!("quic://{}", socket.local_addr()?).parse()?;
+    let remote_addr = socket.peer_addr();
+    let mut endpoint = Endpoint::new_with_abstract_socket(
+        endpoint_config(), None, socket, Arc::new(CoreQuicRuntime),
+    )?;
+    endpoint.set_default_client_config(client_config());
+    let connection = match endpoint.connect_with(etq1_client_config(), remote_addr, "localhost")?
+        .await {
+        Ok(connection) => connection,
+        Err(ConnectionError::VersionMismatch) => endpoint
+            .connect_with(client_config(), remote_addr, "localhost")?.await
+            .context("failed to connect legacy EasyTier QUIC")?,
+        Err(error) => return Err(error).context("failed to connect EasyTier QUIC"),
+    };
+    let (writer, reader) = connection.open_bi().await.context("open QUIC tunnel stream")?;
+    make_tunnel(endpoint, connection, writer, reader, local_url, remote_url, 4500)
+}
+
+struct PendingTunnel {
+    connecting: Connecting,
+    endpoint: Endpoint,
+    local_url: Url,
+    remote_addr: SocketAddr,
+    _permit: OwnedSemaphorePermit,
+}
+
+async fn finish_tunnel(pending: PendingTunnel) -> anyhow::Result<Box<dyn Tunnel>> {
+    let connection = timeout(Duration::from_secs(10), pending.connecting).await
+        .context("QUIC server handshake timed out")?.context("accept QUIC server handshake")?;
+    let (writer, reader) = timeout(Duration::from_secs(10), connection.accept_bi()).await
+        .context("QUIC tunnel stream timed out")?.context("accept QUIC tunnel stream")?;
+    let remote_url = format!("quic://{}", pending.remote_addr).parse()?;
+    make_tunnel(pending.endpoint, connection, writer, reader, pending.local_url, remote_url, 2000)
+}
+
+async fn accept_session(
+    endpoint: Endpoint,
+    local_url: Url,
+    handshakes: Arc<Semaphore>,
+    completed: mpsc::Sender<anyhow::Result<Box<dyn Tunnel>>>,
+) {
+    let mut tasks = JoinSet::new();
+    let mut pending: Option<Incoming> = None;
+    loop {
+        tokio::select! {
+            result = tasks.join_next(), if !tasks.is_empty() => {
+                let result = match result.expect("pending QUIC task exists") {
+                    Ok(result) => result,
+                    Err(error) => Err(error).context("QUIC accept task failed"),
+                };
+                if completed.send(result).await.is_err() { break }
+            }
+            incoming = endpoint.accept(), if pending.is_none() => {
+                let Some(incoming) = incoming else { break };
+                pending = Some(incoming);
+            }
+            permit = handshakes.clone().acquire_owned(), if pending.is_some() => {
+                let Ok(permit) = permit else { break };
+                let incoming = pending.take().expect("pending QUIC connection exists");
+                let remote_addr = incoming.remote_address();
+                match incoming.accept() {
+                    Ok(connecting) => {
+                        tasks.spawn(finish_tunnel(PendingTunnel {
+                            connecting, endpoint: endpoint.clone(), local_url: local_url.clone(),
+                            remote_addr, _permit: permit,
+                        }));
+                    }
+                    Err(error) => {
+                        if completed.send(Err(error).context("QUIC accept connection failed"))
+                            .await.is_err() { break }
+                    }
+                }
+            }
+        }
+    }
+    tasks.shutdown().await;
+}
+
+struct QuicAcceptedSession {
+    completed: mpsc::Receiver<anyhow::Result<Box<dyn Tunnel>>>,
+    _accept_task: AbortOnDropHandle<()>,
+}
+
+impl QuicAcceptedSession {
+    fn new(session: UdpSession, local_url: Url, admission: ServerProtocolAdmission)
+        -> anyhow::Result<Self> {
+        let (active, handshakes) = admission.into_parts();
+        let socket = Arc::new(QuicUdpSessionSocket::from_accepted(session, active)?);
+        let endpoint = Endpoint::new_with_abstract_socket(
+            endpoint_config(), Some(server_config()), socket, Arc::new(CoreQuicRuntime),
+        )?;
+        let (sender, completed) = mpsc::channel(100);
+        let task = tokio::spawn(accept_session(endpoint, local_url, handshakes, sender));
+        Ok(Self { completed, _accept_task: AbortOnDropHandle::new(task) })
+    }
+}
+
+#[async_trait::async_trait]
+impl ServerTunnelAcceptor for QuicAcceptedSession {
+    async fn accept(&mut self) -> anyhow::Result<Box<dyn Tunnel>> {
+        while let Some(result) = self.completed.recv().await {
+            match result {
+                Ok(tunnel) => return Ok(tunnel),
+                Err(error) => tracing::warn!(?error, "QUIC session connection failed"),
+            }
+        }
+        Err(TunnelError::Shutdown.into())
+    }
+}
+
+#[async_trait::async_trait]
+impl<TcpSocket: Send + 'static> ClientProtocolUpgrader<TcpSocket> for QuicProtocol {
+    fn supports_scheme(&self, scheme: &str) -> bool { scheme == "quic" }
+
+    async fn upgrade_client(
+        &self, connected: ConnectedTransport<TcpSocket>, requested_url: Url,
+    ) -> anyhow::Result<Box<dyn Tunnel>> {
+        let ConnectedTransport::Udp(session) = connected else {
+            anyhow::bail!("QUIC requires a UDP session");
+        };
+        connect(session, requested_url).await
+    }
+}
+
+#[async_trait::async_trait]
+impl<TcpSocket: Send + 'static> ServerProtocolUpgrader<TcpSocket> for QuicProtocol {
+    fn supports_scheme(&self, scheme: &str) -> bool { scheme == "quic" }
+
+    async fn upgrade_udp(
+        &self, session: UdpSession, local_url: Url, admission: Option<ServerProtocolAdmission>,
+    ) -> anyhow::Result<ServerProtocolUpgrade> {
+        let admission = admission.context("QUIC listener admission is required")?;
+        Ok(ServerProtocolUpgrade::Acceptor(Box::new(
+            QuicAcceptedSession::new(session, local_url, admission)?,
+        )))
+    }
+
+    async fn upgrade_tcp(&self, _socket: TcpSocket, _local_url: Url) -> anyhow::Result<ServerProtocolUpgrade> {
+        anyhow::bail!("QUIC requires a UDP session");
+    }
+
+    async fn upgrade_byte_stream(
+        &self, _socket: TcpSocket, _local_url: Url, _remote_url: Option<Url>,
+    ) -> anyhow::Result<ServerProtocolUpgrade> {
+        anyhow::bail!("QUIC requires a UDP session");
+    }
+}
diff --git a/easytier-core/src/connectivity/protocol/wireguard.rs b/easytier-core/src/connectivity/protocol/wireguard.rs
new file mode 100644
index 0000000..a07c31a
--- /dev/null
+++ b/easytier-core/src/connectivity/protocol/wireguard.rs
@@ -0,0 +1,216 @@
+use std::{pin::Pin, sync::Arc, time::Duration};
+
+use anyhow::Context;
+use boringtun::{
+    noise::{Tunn, TunnResult, errors::WireGuardError},
+    x25519::{PublicKey, StaticSecret},
+};
+use bytes::BytesMut;
+use futures::{SinkExt, StreamExt};
+use rand::RngCore;
+use tokio::task::JoinSet;
+use url::Url;
+
+use crate::{
+    config::{NetworkIdentity, generate_digest_from_str},
+    foundation::time::interval,
+    packet::{PEER_MANAGER_HEADER_SIZE, WG_TUNNEL_HEADER_SIZE, ZCPacket, ZCPacketType},
+    proto::common::TunnelInfo,
+    socket::udp::{UdpSession, UdpSessionSocket},
+    tunnel::{Tunnel, ZCPacketSink, ring::create_ring_tunnel_pair, wrapper::TunnelWrapper},
+};
+
+use super::{
+    ClientProtocolUpgrader, ServerProtocolAdmission, ServerProtocolUpgrade, ServerProtocolUpgrader,
+};
+use crate::connectivity::transport::{ConnectedTransport, ConnectedUdpSession};
+
+const MAX_PACKET_SIZE: usize = 2048;
+
+pub struct WireGuardProtocol {
+    secret: [u8; 32],
+}
+
+impl WireGuardProtocol {
+    pub fn new(identity: NetworkIdentity) -> Self {
+        let mut secret = [0; 32];
+        generate_digest_from_str(
+            &identity.network_name,
+            &identity.network_secret.unwrap_or_default(),
+            &mut secret,
+        );
+        Self { secret }
+    }
+
+    fn tunn(&self) -> Tunn {
+        let secret = StaticSecret::from(self.secret);
+        let public = PublicKey::from(&secret);
+        Tunn::new(secret, public, None, None, rand::thread_rng().next_u32(), None)
+    }
+}
+
+fn fill_ip_header(packet: &mut ZCPacket) {
+    let len = packet.payload_len() + PEER_MANAGER_HEADER_SIZE + 20;
+    let header = &mut packet.mut_wg_tunnel_header().unwrap().ipv4_header;
+    header.fill(0);
+    header[0] = 0x45;
+    header[2..4].copy_from_slice(&(len as u16).to_be_bytes());
+    header[8] = 64;
+}
+
+async fn dispatch(
+    result: TunnResult<'_>,
+    session: &dyn UdpSessionSocket,
+    sink: &mut Pin<Box<dyn ZCPacketSink>>,
+) -> anyhow::Result<bool> {
+    match result {
+        TunnResult::WriteToNetwork(packet) => {
+            session.send(packet).await?;
+            Ok(true)
+        }
+        TunnResult::WriteToTunnelV4(packet, _) | TunnResult::WriteToTunnelV6(packet, _) => {
+            let header_len = if packet[0] >> 4 == 4 { 20 } else { 40 };
+            let mut data = BytesMut::zeroed(WG_TUNNEL_HEADER_SIZE);
+            data.extend_from_slice(&packet[header_len..]);
+            sink.send(ZCPacket::new_from_buf(data, ZCPacketType::WG)).await?;
+            Ok(false)
+        }
+        TunnResult::Err(error) => {
+            tracing::debug!(?error, "WireGuard packet rejected");
+            Ok(false)
+        }
+        TunnResult::Done => Ok(false),
+    }
+}
+
+fn start_tunnel(
+    mut tunn: Tunn,
+    session: Arc<dyn UdpSessionSocket>,
+    guard: Box<dyn Send + Sync>,
+    requested_url: Url,
+    first_packet: Option<Vec<u8>>,
+) -> anyhow::Result<Box<dyn Tunnel>> {
+    let local = session.local_addr()?;
+    let remote = session.peer_addr()?;
+    let (internal, external) = create_ring_tunnel_pair();
+    let (mut stream, mut sink) = internal.split();
+    let mut tasks = JoinSet::new();
+    tasks.spawn(async move {
+        let _guard = guard;
+        let mut receive = [0; MAX_PACKET_SIZE];
+        let mut output = [0; MAX_PACKET_SIZE];
+        let mut ticker = interval(Duration::from_millis(250));
+        let result: anyhow::Result<()> = async {
+            if let Some(packet) = first_packet {
+                let mut next = tunn.decapsulate(None, &packet, &mut output);
+                while dispatch(next, session.as_ref(), &mut sink).await? {
+                    next = tunn.decapsulate(None, &[], &mut output);
+                }
+            }
+            loop {
+                tokio::select! {
+                    packet = stream.next() => {
+                        let Some(packet) = packet else { break };
+                        let mut packet = packet?.convert_type(ZCPacketType::WG);
+                        fill_ip_header(&mut packet);
+                        let data = packet.into_bytes();
+                        let result = tunn.encapsulate(&data, &mut output);
+                        dispatch(result, session.as_ref(), &mut sink).await?;
+                    }
+                    received = session.recv(&mut receive) => {
+                        let size = received?;
+                        let mut next = tunn.decapsulate(None, &receive[..size], &mut output);
+                        while dispatch(next, session.as_ref(), &mut sink).await? {
+                            next = tunn.decapsulate(None, &[], &mut output);
+                        }
+                    }
+                    _ = ticker.tick() => {
+                        let mut result = tunn.update_timers(&mut output);
+                        if matches!(result, TunnResult::Err(WireGuardError::ConnectionExpired)) {
+                            result = tunn.format_handshake_initiation(&mut output, false);
+                        }
+                        dispatch(result, session.as_ref(), &mut sink).await?;
+                    }
+                }
+            }
+            Ok(())
+        }.await;
+        if let Err(error) = result {
+            tracing::warn!(%error, %local, %remote, "WireGuard tunnel stopped");
+        }
+    });
+    let (stream, sink) = external.split();
+    Ok(Box::new(TunnelWrapper::new_with_associate_data(
+        stream,
+        sink,
+        Some(TunnelInfo {
+            tunnel_type: "wg".to_owned(),
+            local_addr: Some(format!("wg://{local}").parse::<Url>()?.into()),
+            remote_addr: Some(requested_url.into()),
+            resolved_remote_addr: Some(format!("wg://{remote}").parse::<Url>()?.into()),
+        }),
+        Some(Box::new(tasks)),
+    )))
+}
+
+async fn connect(
+    protocol: &WireGuardProtocol,
+    connected: ConnectedUdpSession,
+    requested_url: Url,
+) -> anyhow::Result<Box<dyn Tunnel>> {
+    let (session, guard) = connected.into_parts();
+    let session: Arc<dyn UdpSessionSocket> = Arc::new(session);
+    let mut tunn = protocol.tunn();
+    let mut buffer = [0; MAX_PACKET_SIZE];
+    let TunnResult::WriteToNetwork(handshake) = tunn.format_handshake_initiation(&mut buffer, false) else {
+        anyhow::bail!("failed to generate WireGuard handshake");
+    };
+    session.send(handshake).await.context("send WireGuard handshake")?;
+    let size = session.recv(&mut buffer).await.context("receive WireGuard handshake")?;
+    start_tunnel(tunn, session, guard, requested_url, Some(buffer[..size].to_vec()))
+}
+
+#[async_trait::async_trait]
+impl<TcpSocket: Send + 'static> ClientProtocolUpgrader<TcpSocket> for WireGuardProtocol {
+    fn supports_scheme(&self, scheme: &str) -> bool { scheme == "wg" }
+
+    async fn upgrade_client(
+        &self,
+        connected: ConnectedTransport<TcpSocket>,
+        requested_url: Url,
+    ) -> anyhow::Result<Box<dyn Tunnel>> {
+        let ConnectedTransport::Udp(session) = connected else {
+            anyhow::bail!("WireGuard protocol requires a UDP session");
+        };
+        connect(self, session, requested_url).await
+    }
+}
+
+#[async_trait::async_trait]
+impl<TcpSocket: Send + 'static> ServerProtocolUpgrader<TcpSocket> for WireGuardProtocol {
+    fn supports_scheme(&self, scheme: &str) -> bool { scheme == "wg" }
+
+    async fn upgrade_udp(
+        &self,
+        session: UdpSession,
+        _local_url: Url,
+        _admission: Option<ServerProtocolAdmission>,
+    ) -> anyhow::Result<ServerProtocolUpgrade> {
+        let requested_url = format!("wg://{}", session.peer_addr()?).parse()?;
+        let tunnel = start_tunnel(self.tunn(), Arc::new(session), Box::new(()), requested_url, None)?;
+        Ok(ServerProtocolUpgrade::Tunnel(tunnel))
+    }
+
+    async fn upgrade_tcp(&self, _socket: TcpSocket, _local_url: Url) -> anyhow::Result<ServerProtocolUpgrade> {
+        anyhow::bail!("WireGuard protocol requires a UDP session");
+    }
+
+    async fn upgrade_byte_stream(
+        &self,
+        _socket: TcpSocket,
+        _local_url: Url,
+        _remote_url: Option<Url>,
+    ) -> anyhow::Result<ServerProtocolUpgrade> {
+        anyhow::bail!("WireGuard protocol requires a UDP session");
+    }
+}
diff --git a/easytier-core/src/gateway/proxy/mihomo_kcp.rs b/easytier-core/src/gateway/proxy/mihomo_kcp.rs
new file mode 100644
index 0000000..e7623cc
--- /dev/null
+++ b/easytier-core/src/gateway/proxy/mihomo_kcp.rs
@@ -0,0 +1,308 @@
+//! Official EasyTier KCP endpoint integration for the portable core.
+
+use std::{net::SocketAddr, sync::Arc, time::Duration};
+
+use anyhow::{Context, anyhow};
+use bytes::{Bytes, BytesMut};
+use futures::{StreamExt, stream::FuturesUnordered};
+use kcp_sys::{
+    endpoint::{KcpEndpoint, KcpPacketReceiver},
+    ffi_safe::KcpConfig,
+    packet_def::KcpPacket,
+    stream::KcpStream,
+};
+use prost::Message;
+use tokio::{sync::Mutex, task::JoinSet};
+use tokio_util::sync::CancellationToken;
+
+use crate::{foundation::time::sleep, proto::peer_rpc::KcpConnData};
+
+use super::{
+    traits::TcpProxyStream,
+    wrapped_transport::{
+        WrappedTransportAcceptedStream, WrappedTransportConnect, WrappedTransportDatagram,
+        WrappedTransportDatagramBuffer, WrappedTransportEngine, WrappedTransportEngineStart,
+        WrappedTransportKind, WrappedTransportRole,
+    },
+};
+
+fn create_kcp_endpoint() -> KcpEndpoint {
+    let mut endpoint = KcpEndpoint::new();
+    endpoint.set_kcp_config_factory(Box::new(|conv| {
+        let mut config = KcpConfig::new_turbo(conv);
+        config.interval = Some(5);
+        config
+    }));
+    endpoint
+}
+
+async fn forward_output(
+    mut receiver: KcpPacketReceiver,
+    role: WrappedTransportRole,
+    datagrams: tokio::sync::mpsc::Sender<WrappedTransportDatagram>,
+) {
+    while let Some(packet) = receiver.recv().await {
+        let peer_id = match role {
+            WrappedTransportRole::Source => packet.header().dst_session_id(),
+            WrappedTransportRole::Destination => packet.header().src_session_id(),
+        };
+        if datagrams
+            .send(WrappedTransportDatagram {
+                transport: WrappedTransportKind::Kcp,
+                role,
+                peer_id,
+                buffer: WrappedTransportDatagramBuffer::copy_from_payload(
+                    &packet.inner().freeze(),
+                ),
+            })
+            .await
+            .is_err()
+        {
+            break;
+        }
+    }
+}
+
+async fn connect_source(
+    endpoint: Arc<KcpEndpoint>,
+    request: WrappedTransportConnect,
+) -> anyhow::Result<KcpStream> {
+    let data = Bytes::from(
+        KcpConnData {
+            src: Some(request.src.into()),
+            dst: Some(request.dst.into()),
+        }
+        .encode_to_vec(),
+    );
+    let connect = || {
+        let endpoint = endpoint.clone();
+        let data = data.clone();
+        async move {
+            let connection = endpoint
+                .connect(
+                    Duration::from_secs(10),
+                    request.my_peer_id,
+                    request.dst_peer_id,
+                    data,
+                )
+                .await?;
+            KcpStream::new(&endpoint, connection).context("failed to create KCP stream")
+        }
+    };
+    let mut attempts = FuturesUnordered::new();
+    let mut started = 1;
+    let mut errors = Vec::new();
+    attempts.push(connect());
+    while !attempts.is_empty() {
+        tokio::select! {
+            result = attempts.next() => {
+                match result.expect("pending KCP attempt exists") {
+                    Ok(stream) => return Ok(stream),
+                    Err(error) => errors.push(error),
+                }
+                if started < 5 {
+                    started += 1;
+                    attempts.push(connect());
+                }
+            }
+            _ = sleep(Duration::from_millis(200)), if started < 5 => {
+                started += 1;
+                attempts.push(connect());
+            }
+        }
+    }
+    Err(anyhow!("failed to connect KCP to peer: {errors:?}"))
+}
+
+async fn submit_destination(
+    stream: KcpStream,
+    ingress: super::wrapped_transport::WrappedTransportDestinationIngress,
+) -> anyhow::Result<()> {
+    let data = stream.conn_data().clone();
+    let parsed = KcpConnData::decode(data.clone())
+        .with_context(|| format!("failed to decode KCP connection metadata: {data:?}"))?;
+    let dst: SocketAddr = parsed
+        .dst
+        .ok_or_else(|| anyhow!("KCP connection metadata has no destination"))?
+        .into();
+    let src: SocketAddr = parsed.src.unwrap_or_default().into();
+    ingress
+        .submit(WrappedTransportAcceptedStream {
+            src,
+            dst,
+            initial_acl_packet_size: data.len(),
+            stream: Box::new(stream),
+        })
+        .await
+}
+
+struct KcpEngineState {
+    src: Option<Arc<KcpEndpoint>>,
+    dst: Option<Arc<KcpEndpoint>>,
+    destination_ingress: Option<super::wrapped_transport::WrappedTransportDestinationIngress>,
+    tasks: JoinSet<()>,
+    accept_cancel: CancellationToken,
+    accept_task: Option<tokio::task::JoinHandle<()>>,
+}
+
+impl KcpEngineState {
+    fn endpoint(&self, role: WrappedTransportRole) -> Option<Arc<KcpEndpoint>> {
+        match role {
+            WrappedTransportRole::Source => self.src.clone(),
+            WrappedTransportRole::Destination => self.dst.clone(),
+        }
+    }
+
+    async fn stop(&mut self) {
+        self.accept_cancel.cancel();
+        if let Some(task) = self.accept_task.as_mut() {
+            let _ = task.await;
+        }
+        self.accept_task.take();
+        self.tasks.shutdown().await;
+        self.src.take();
+        self.dst.take();
+    }
+}
+
+#[derive(Default)]
+pub struct KcpProxyService {
+    state: Mutex<Option<KcpEngineState>>,
+}
+
+impl KcpProxyService {
+    pub fn new() -> Self {
+        Self::default()
+    }
+}
+
+#[async_trait::async_trait]
+impl WrappedTransportEngine for KcpProxyService {
+    async fn prepare(&self, options: WrappedTransportEngineStart) -> anyhow::Result<()> {
+        let mut state = self.state.lock().await;
+        if state.is_some() {
+            return Ok(());
+        }
+        if options.directions.destination && options.destination_ingress.is_none() {
+            anyhow::bail!("KCP destination ingress is required");
+        }
+        let mut next = KcpEngineState {
+            src: None,
+            dst: None,
+            destination_ingress: options.destination_ingress,
+            tasks: JoinSet::new(),
+            accept_cancel: CancellationToken::new(),
+            accept_task: None,
+        };
+        for (enabled, role) in [
+            (options.directions.source, WrappedTransportRole::Source),
+            (
+                options.directions.destination,
+                WrappedTransportRole::Destination,
+            ),
+        ] {
+            if !enabled {
+                continue;
+            }
+            let mut endpoint = create_kcp_endpoint();
+            endpoint.run().await;
+            let output = endpoint
+                .output_receiver()
+                .expect("new KCP endpoint has an output receiver");
+            next.tasks
+                .spawn(forward_output(output, role, options.datagrams.clone()));
+            let endpoint = Arc::new(endpoint);
+            match role {
+                WrappedTransportRole::Source => next.src = Some(endpoint),
+                WrappedTransportRole::Destination => next.dst = Some(endpoint),
+            }
+        }
+        *state = Some(next);
+        Ok(())
+    }
+
+    async fn activate(&self) -> anyhow::Result<()> {
+        let mut state = self.state.lock().await;
+        let state = state
+            .as_mut()
+            .ok_or_else(|| anyhow!("KCP engine is not prepared"))?;
+        let Some(endpoint) = state.dst.clone() else {
+            return Ok(());
+        };
+        if state.accept_task.is_some() {
+            return Ok(());
+        }
+        let ingress = state
+            .destination_ingress
+            .clone()
+            .expect("prepared KCP destination has ingress");
+        let cancel = state.accept_cancel.clone();
+        state.accept_task = Some(tokio::spawn(async move {
+            let mut streams = JoinSet::new();
+            loop {
+                tokio::select! {
+                    biased;
+                    _ = cancel.cancelled() => break,
+                    accepted = endpoint.accept() => {
+                        let Ok(connection) = accepted else { break };
+                        let Some(stream) = KcpStream::new(&endpoint, connection) else {
+                            tracing::warn!("failed to create accepted KCP stream");
+                            continue;
+                        };
+                        let ingress = ingress.clone();
+                        streams.spawn(async move {
+                            if let Err(error) = submit_destination(stream, ingress).await {
+                                tracing::warn!(?error, "failed to admit KCP destination stream");
+                            }
+                        });
+                    }
+                    _ = streams.join_next(), if !streams.is_empty() => {}
+                }
+            }
+            streams.shutdown().await;
+        }));
+        Ok(())
+    }
+
+    async fn inject_peer_datagram(
+        &self,
+        role: WrappedTransportRole,
+        _from_peer_id: u32,
+        payload: Bytes,
+    ) -> anyhow::Result<()> {
+        let endpoint = self
+            .state
+            .lock()
+            .await
+            .as_ref()
+            .and_then(|state| state.endpoint(role))
+            .ok_or_else(|| anyhow!("KCP {role:?} endpoint is not active"))?;
+        endpoint
+            .input_sender_ref()
+            .send(KcpPacket::from(BytesMut::from(payload)))
+            .await
+            .map_err(|error| anyhow!("failed to inject KCP datagram: {error}"))
+    }
+
+    async fn connect_source(
+        &self,
+        request: WrappedTransportConnect,
+    ) -> anyhow::Result<Box<dyn TcpProxyStream>> {
+        let endpoint = self
+            .state
+            .lock()
+            .await
+            .as_ref()
+            .and_then(|state| state.src.clone())
+            .ok_or_else(|| anyhow!("KCP source endpoint is not prepared"))?;
+        Ok(Box::new(connect_source(endpoint, request).await?))
+    }
+
+    async fn stop(&self) {
+        let mut state = self.state.lock().await;
+        if let Some(active) = state.as_mut() {
+            active.stop().await;
+        }
+        state.take();
+    }
+}
diff --git a/easytier-core/src/gateway/proxy/mihomo_quic.rs b/easytier-core/src/gateway/proxy/mihomo_quic.rs
new file mode 100644
index 0000000..c88055e
--- /dev/null
+++ b/easytier-core/src/gateway/proxy/mihomo_quic.rs
@@ -0,0 +1,474 @@
+//! Official EasyTier QUIC proxy wire protocol over the core peer packet plane.
+
+use std::{
+    collections::HashMap,
+    io::{self, IoSliceMut},
+    net::{IpAddr, Ipv4Addr, SocketAddr},
+    pin::Pin,
+    sync::{Arc, Mutex as StdMutex},
+    task::{Context, Poll},
+    time::Duration,
+};
+
+use anyhow::{Context as _, anyhow};
+use bytes::{BufMut, Bytes};
+use futures::{StreamExt, stream::FuturesUnordered};
+use prost::Message;
+use quinn::{
+    AsyncUdpSocket, Connection, ConnectionError, Endpoint, RecvStream, SendStream, UdpPoller,
+    WriteError,
+    udp::{RecvMeta, Transmit},
+};
+use tokio::{
+    io::{AsyncReadExt, Join, join},
+    sync::{Mutex, mpsc},
+    task::{JoinHandle, JoinSet},
+};
+use tokio_util::sync::{CancellationToken, PollSender};
+
+use crate::{
+    foundation::{expiring_set::ExpiringSet, time::{sleep, timeout}},
+    packet::PacketType,
+    proto::peer_rpc::KcpConnData,
+    tunnel::mihomo_quic::{
+        CoreQuicRuntime, QUIC_VERSION_ETQ1, client_config, endpoint_config, etq1_client_config,
+        server_config,
+    },
+};
+
+use super::{
+    traits::TcpProxyStream,
+    wrapped_transport::{
+        WrappedTransportAcceptedStream, WrappedTransportConnect, WrappedTransportDatagram,
+        WrappedTransportDatagramBuffer, WrappedTransportDestinationIngress, WrappedTransportEngine,
+        WrappedTransportEngineStart, WrappedTransportKind, WrappedTransportRole,
+    },
+};
+
+#[derive(Debug)]
+struct Datagram {
+    addr: SocketAddr,
+    payload: Bytes,
+}
+
+#[derive(Debug)]
+struct QuicSocket {
+    addr: SocketAddr,
+    input: StdMutex<mpsc::Receiver<Datagram>>,
+    output: mpsc::Sender<Datagram>,
+}
+
+#[derive(Debug)]
+struct Writable {
+    output: PollSender<Datagram>,
+}
+
+impl UdpPoller for Writable {
+    fn poll_writable(mut self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<io::Result<()>> {
+        let result = self.output.poll_reserve(context);
+        if matches!(result, Poll::Ready(Ok(_))) {
+            self.output.abort_send();
+        }
+        result.map_err(|error| io::Error::new(io::ErrorKind::BrokenPipe, error))
+    }
+}
+
+impl AsyncUdpSocket for QuicSocket {
+    fn create_io_poller(self: Arc<Self>) -> Pin<Box<dyn UdpPoller>> {
+        Box::pin(Writable {
+            output: PollSender::new(self.output.clone()),
+        })
+    }
+
+    fn try_send(&self, transmit: &Transmit) -> io::Result<()> {
+        if !transmit.destination.is_ipv4() {
+            return Err(io::ErrorKind::ConnectionRefused.into());
+        }
+        let permit = self.output.try_reserve().map_err(|error| match error {
+            mpsc::error::TrySendError::Full(_) => io::ErrorKind::WouldBlock,
+            mpsc::error::TrySendError::Closed(_) => io::ErrorKind::BrokenPipe,
+        })?;
+        permit.send(Datagram {
+            addr: transmit.destination,
+            payload: Bytes::copy_from_slice(transmit.contents),
+        });
+        Ok(())
+    }
+
+    fn poll_recv(
+        &self,
+        context: &mut Context<'_>,
+        buffers: &mut [IoSliceMut<'_>],
+        metadata: &mut [RecvMeta],
+    ) -> Poll<io::Result<usize>> {
+        if buffers.is_empty() || metadata.is_empty() {
+            return Poll::Ready(Ok(0));
+        }
+        let mut input = self.input.lock().expect("QUIC receive mutex poisoned");
+        let mut received = 0;
+        for (buffer, meta) in buffers.iter_mut().zip(metadata.iter_mut()) {
+            match input.poll_recv(context) {
+                Poll::Ready(Some(packet)) => {
+                    let len = packet.payload.len();
+                    if len > buffer.len() {
+                        tracing::warn!(len, capacity = buffer.len(), "QUIC receive buffer too small");
+                        continue;
+                    }
+                    buffer[..len].copy_from_slice(&packet.payload);
+                    *meta = RecvMeta {
+                        addr: packet.addr,
+                        len,
+                        stride: len,
+                        ecn: None,
+                        dst_ip: None,
+                    };
+                    received += 1;
+                }
+                Poll::Ready(None) if received > 0 => break,
+                Poll::Ready(None) => return Poll::Ready(Err(io::ErrorKind::ConnectionAborted.into())),
+                Poll::Pending => break,
+            }
+        }
+        if received == 0 {
+            Poll::Pending
+        } else {
+            Poll::Ready(Ok(received))
+        }
+    }
+
+    fn local_addr(&self) -> io::Result<SocketAddr> {
+        Ok(self.addr)
+    }
+}
+
+fn peer_address(peer_id: u32, role: WrappedTransportRole) -> SocketAddr {
+    let packet_type = match role {
+        WrappedTransportRole::Source => PacketType::QuicSrc,
+        WrappedTransportRole::Destination => PacketType::QuicDst,
+    };
+    SocketAddr::new(Ipv4Addr::from(peer_id).into(), packet_type as u16)
+}
+
+async fn forward_output(
+    mut receiver: mpsc::Receiver<Datagram>,
+    datagrams: mpsc::Sender<WrappedTransportDatagram>,
+) {
+    while let Some(packet) = receiver.recv().await {
+        let IpAddr::V4(peer) = packet.addr.ip() else {
+            tracing::error!(addr = ?packet.addr, "invalid QUIC proxy peer address");
+            continue;
+        };
+        let role = match packet.addr.port() {
+            port if port == PacketType::QuicSrc as u16 => WrappedTransportRole::Source,
+            port if port == PacketType::QuicDst as u16 => WrappedTransportRole::Destination,
+            _ => {
+                tracing::error!(addr = ?packet.addr, "invalid QUIC proxy packet role");
+                continue;
+            }
+        };
+        if datagrams.send(WrappedTransportDatagram {
+            transport: WrappedTransportKind::Quic,
+            role,
+            peer_id: peer.into(),
+            buffer: WrappedTransportDatagramBuffer::copy_from_payload(&packet.payload),
+        }).await.is_err() {
+            break;
+        }
+    }
+}
+
+type QuicStream = Join<RecvStream, SendStream>;
+type ConnectionSlot = Arc<Mutex<Option<Connection>>>;
+
+struct SourceConnector {
+    endpoint: Endpoint,
+    connections: Mutex<HashMap<u32, ConnectionSlot>>,
+    legacy_version_peers: ExpiringSet<u32>,
+}
+
+impl SourceConnector {
+    async fn connect_hedge(&self, peer: u32, version: u32) -> anyhow::Result<Connection> {
+        let connect = || async {
+            let config = if version == QUIC_VERSION_ETQ1 {
+                etq1_client_config()
+            } else {
+                client_config()
+            };
+            let result = self.endpoint.connect_with(
+                config,
+                peer_address(peer, WrappedTransportRole::Source),
+                "",
+            ).context("failed to create QUIC connection")?.await;
+            if matches!(result, Err(ConnectionError::VersionMismatch)) {
+                self.legacy_version_peers.insert(peer, Duration::from_secs(3600));
+            }
+            result.context("QUIC connection failed")
+        };
+        let mut attempts = FuturesUnordered::new();
+        let mut started = 1;
+        let mut errors = Vec::new();
+        attempts.push(connect());
+        while !attempts.is_empty() {
+            tokio::select! {
+                result = attempts.next() => {
+                    match result.expect("pending QUIC attempt exists") {
+                        Ok(connection) => return Ok(connection),
+                        Err(error) => errors.push(error),
+                    }
+                    if started < 5 {
+                        started += 1;
+                        attempts.push(connect());
+                    }
+                }
+                _ = sleep(Duration::from_millis(200)), if started < 5 => {
+                    started += 1;
+                    attempts.push(connect());
+                }
+            }
+        }
+        Err(anyhow!("failed to connect QUIC to peer {peer}: {errors:?}"))
+    }
+
+    async fn connect(&self, peer: u32) -> anyhow::Result<Connection> {
+        self.legacy_version_peers.cleanup();
+        if !self.legacy_version_peers.contains(&peer) {
+            match self.connect_hedge(peer, QUIC_VERSION_ETQ1).await {
+                Ok(connection) => return Ok(connection),
+                Err(_) if self.legacy_version_peers.contains(&peer) => {}
+                Err(error) => return Err(error),
+            }
+        }
+        self.connect_hedge(peer, 1).await
+    }
+
+    async fn connect_stream(&self, request: WrappedTransportConnect) -> anyhow::Result<QuicStream> {
+        let data = KcpConnData {
+            src: Some(request.src.into()),
+            dst: Some(request.dst.into()),
+        };
+        let mut header = Vec::with_capacity(2 + data.encoded_len());
+        header.put_u16(u16::try_from(data.encoded_len()).context("QUIC metadata too large")?);
+        data.encode(&mut header)?;
+        let slot = {
+            let mut connections = self.connections.lock().await;
+            connections.retain(|_, slot| {
+                slot.try_lock().map_or(true, |connection| {
+                    connection.as_ref().is_some_and(|connection| connection.close_reason().is_none())
+                })
+            });
+            connections.entry(request.dst_peer_id).or_default().clone()
+        };
+        let mut connection = slot.lock().await;
+        let mut reconnected = connection.as_ref().is_none_or(|value| value.close_reason().is_some());
+        if reconnected {
+            *connection = Some(self.connect(request.dst_peer_id).await?);
+        }
+        loop {
+            let current = connection.as_ref().expect("QUIC connection is established");
+            let mut retry = !reconnected;
+            let result = async {
+                let (mut writer, reader) = current.open_bi().await.inspect_err(|error| {
+                    retry &= retryable(error);
+                })?;
+                writer.write_all(&header).await.inspect_err(|error| {
+                    retry &= matches!(error, WriteError::ConnectionLost(error) if retryable(error));
+                })?;
+                Ok(join(reader, writer))
+            }.await;
+            if result.is_err() {
+                if retry {
+                    reconnected = true;
+                    *connection = Some(self.connect(request.dst_peer_id).await?);
+                    continue;
+                }
+                connection.take();
+            }
+            return result;
+        }
+    }
+}
+
+fn retryable(error: &ConnectionError) -> bool {
+    matches!(error,
+        ConnectionError::ConnectionClosed(_) | ConnectionError::ApplicationClosed(_)
+        | ConnectionError::Reset | ConnectionError::TimedOut
+    )
+}
+
+async fn submit_stream(
+    mut stream: QuicStream,
+    ingress: WrappedTransportDestinationIngress,
+) -> anyhow::Result<()> {
+    let len = timeout(Duration::from_secs(5), stream.read_u16()).await
+        .context("timeout reading QUIC metadata length")??;
+    anyhow::ensure!(len <= 512, "QUIC stream metadata too large: {len}");
+    let mut data = vec![0; len as usize];
+    timeout(Duration::from_secs(5), stream.read_exact(&mut data)).await
+        .context("timeout reading QUIC metadata")??;
+    let parsed = KcpConnData::decode(data.as_slice()).context("failed to decode QUIC metadata")?;
+    ingress.submit(WrappedTransportAcceptedStream {
+        src: parsed.src.ok_or_else(|| anyhow!("QUIC metadata has no source"))?.into(),
+        dst: parsed.dst.ok_or_else(|| anyhow!("QUIC metadata has no destination"))?.into(),
+        initial_acl_packet_size: data.len(),
+        stream: Box::new(stream),
+    }).await
+}
+
+async fn accept_streams(
+    endpoint: Endpoint,
+    ingress: WrappedTransportDestinationIngress,
+    cancel: CancellationToken,
+) {
+    let mut connections = JoinSet::new();
+    loop {
+        tokio::select! {
+            biased;
+            _ = cancel.cancelled() => break,
+            incoming = endpoint.accept() => {
+                let Some(incoming) = incoming else { break };
+                let ingress = ingress.clone();
+                let cancel = cancel.clone();
+                connections.spawn(async move {
+                    let connected = tokio::select! {
+                        biased;
+                        _ = cancel.cancelled() => return,
+                        result = incoming => result,
+                    };
+                    let connection = match connected {
+                        Ok(connection) => connection,
+                        Err(error) => {
+                            tracing::warn!(?error, "failed to accept QUIC proxy connection");
+                            return;
+                        }
+                    };
+                    let mut streams = JoinSet::new();
+                    loop {
+                        tokio::select! {
+                            biased;
+                            _ = cancel.cancelled() => break,
+                            accepted = connection.accept_bi() => {
+                                let (writer, reader) = match accepted {
+                                    Ok(stream) => stream,
+                                    Err(_) => break,
+                                };
+                                let ingress = ingress.clone();
+                                streams.spawn(async move {
+                                    if let Err(error) = submit_stream(join(reader, writer), ingress).await {
+                                        tracing::warn!(?error, "failed to admit QUIC destination stream");
+                                    }
+                                });
+                            }
+                            _ = streams.join_next(), if !streams.is_empty() => {}
+                        }
+                    }
+                    streams.shutdown().await;
+                    connection.close(1u32.into(), b"stopped");
+                });
+            }
+            _ = connections.join_next(), if !connections.is_empty() => {}
+        }
+    }
+    connections.shutdown().await;
+}
+
+struct QuicEngineState {
+    endpoint: Endpoint,
+    input: mpsc::Sender<Datagram>,
+    source: Option<Arc<SourceConnector>>,
+    ingress: Option<WrappedTransportDestinationIngress>,
+    tasks: JoinSet<()>,
+    accept_cancel: CancellationToken,
+    accept_task: Option<JoinHandle<()>>,
+}
+
+#[derive(Default)]
+pub struct QuicProxyService {
+    state: Mutex<Option<QuicEngineState>>,
+}
+
+impl QuicProxyService {
+    pub fn new() -> Self {
+        Self::default()
+    }
+}
+
+#[async_trait::async_trait]
+impl WrappedTransportEngine for QuicProxyService {
+    async fn prepare(&self, options: WrappedTransportEngineStart) -> anyhow::Result<()> {
+        let mut state = self.state.lock().await;
+        if state.is_some() {
+            return Ok(());
+        }
+        let ingress = if options.directions.destination {
+            Some(options.destination_ingress.ok_or_else(|| anyhow!("QUIC destination ingress is required"))?)
+        } else {
+            None
+        };
+        let (input, receiver) = mpsc::channel(1024);
+        let (output, outgoing) = mpsc::channel(1024);
+        let socket = QuicSocket {
+            addr: SocketAddr::new(Ipv4Addr::from(options.my_peer_id).into(), 0),
+            input: StdMutex::new(receiver),
+            output,
+        };
+        let mut endpoint = Endpoint::new_with_abstract_socket(
+            endpoint_config(), Some(server_config()), Arc::new(socket), Arc::new(CoreQuicRuntime),
+        ).context("failed to create QUIC proxy endpoint")?;
+        endpoint.set_default_client_config(client_config());
+        let source = options.directions.source.then(|| Arc::new(SourceConnector {
+            endpoint: endpoint.clone(),
+            connections: Mutex::new(HashMap::new()),
+            legacy_version_peers: ExpiringSet::default(),
+        }));
+        let mut tasks = JoinSet::new();
+        tasks.spawn(forward_output(outgoing, options.datagrams));
+        *state = Some(QuicEngineState {
+            endpoint, input, source, ingress, tasks,
+            accept_cancel: CancellationToken::new(), accept_task: None,
+        });
+        Ok(())
+    }
+
+    async fn activate(&self) -> anyhow::Result<()> {
+        let mut state = self.state.lock().await;
+        let state = state.as_mut().ok_or_else(|| anyhow!("QUIC engine is not prepared"))?;
+        if state.accept_task.is_none() {
+            if let Some(ingress) = state.ingress.clone() {
+                state.accept_task = Some(tokio::spawn(accept_streams(
+                    state.endpoint.clone(), ingress, state.accept_cancel.clone(),
+                )));
+            }
+        }
+        Ok(())
+    }
+
+    async fn inject_peer_datagram(
+        &self, role: WrappedTransportRole, from_peer_id: u32, payload: Bytes,
+    ) -> anyhow::Result<()> {
+        let input = self.state.lock().await.as_ref()
+            .map(|state| state.input.clone())
+            .ok_or_else(|| anyhow!("QUIC endpoint is not active"))?;
+        input.try_send(Datagram { addr: peer_address(from_peer_id, role), payload })
+            .map_err(|error| anyhow!("failed to inject QUIC datagram: {error}"))
+    }
+
+    async fn connect_source(&self, request: WrappedTransportConnect) -> anyhow::Result<Box<dyn TcpProxyStream>> {
+        let source = self.state.lock().await.as_ref().and_then(|state| state.source.clone())
+            .ok_or_else(|| anyhow!("QUIC source endpoint is not prepared"))?;
+        Ok(Box::new(source.connect_stream(request).await?))
+    }
+
+    async fn stop(&self) {
+        let mut state = self.state.lock().await;
+        if let Some(active) = state.as_mut() {
+            active.accept_cancel.cancel();
+            active.endpoint.close(1u32.into(), b"stopped");
+            if let Some(task) = active.accept_task.as_mut() {
+                let _ = task.await;
+            }
+            active.accept_task.take();
+            active.tasks.shutdown().await;
+        }
+        state.take();
+    }
+}
