index 0000000..be9e003
--- /dev/null
+++ b/easytier-core/src/tunnel/mihomo_quic.rs
@@ -0,0 +1,341 @@
+//! EasyTier QUIC wire configuration and runtime for host-backed datagram sockets.
+
+use std::{
+    future::Future,
+    pin::Pin,
+    sync::Arc,
+    task::{Context, Poll},
+    time::{Duration, Instant},
+};
+
+use quinn::{
+    AsyncTimer, ClientConfig, EndpointConfig, Runtime, ServerConfig,
+    TransportConfig, congestion::BbrConfig,
+};
+
+pub const QUIC_VERSION_ETQ1: u32 = 0x45545131;
+
+#[derive(Debug)]
+pub struct CoreQuicRuntime;
+
+struct CoreQuicTimer {
+    sleep: Pin<Box<dyn Future<Output = ()> + Send>>,
+}
+
+impl std::fmt::Debug for CoreQuicTimer {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("CoreQuicTimer")
+    }
+}
+
+impl CoreQuicTimer {
+    fn sleep(deadline: Instant) -> Pin<Box<dyn Future<Output = ()> + Send>> {
+        Box::pin(crate::foundation::time::sleep_until(
+            crate::foundation::time::Instant::from_std(deadline),
+        ))
+    }
+}
+
+impl AsyncTimer for CoreQuicTimer {
+    fn reset(mut self: Pin<&mut Self>, deadline: Instant) {
+        self.sleep = Self::sleep(deadline);
+    }
+
+    fn poll(mut self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<()> {
+        self.sleep.as_mut().poll(context)
+    }
+}
+
+impl Runtime for CoreQuicRuntime {
+    fn new_timer(&self, deadline: Instant) -> Pin<Box<dyn AsyncTimer>> {
+        Box::pin(CoreQuicTimer {
+            sleep: CoreQuicTimer::sleep(deadline),
+        })
+    }
+
+    fn spawn(&self, future: Pin<Box<dyn Future<Output = ()> + Send>>) {
+        tokio::spawn(future);
+    }
+
+    #[cfg(not(target_os = "wasi"))]
+    fn wrap_udp_socket(&self, _socket: std::net::UdpSocket) -> std::io::Result<Arc<dyn quinn::AsyncUdpSocket>> {
+        Err(std::io::Error::new(
+            std::io::ErrorKind::Unsupported,
+            "EasyTier QUIC requires a host-backed datagram socket",
+        ))
+    }
+}
+
+mod crypto {
+    use std::{any::Any, hash::Hasher, sync::Arc};
+
+    use bytes::{Buf, BytesMut};
+    use quinn_proto::{
+        ConnectError, ConnectionId, Side, TransportError,
+        crypto::{
+            ClientConfig, CryptoError, ExportKeyingMaterialError, HeaderKey, KeyPair, Keys,
+            PacketKey, ServerConfig, Session, UnsupportedVersion,
+        },
+        transport_parameters::TransportParameters,
+    };
+    use seahash::SeaHasher;
+
+    #[derive(Debug, Clone, Copy)]
+    struct CryptoKey {
+        pn_bound: bool,
+    }
+
+    impl CryptoKey {
+        fn for_version(version: u32) -> Self {
+            Self {
+                pn_bound: version == super::QUIC_VERSION_ETQ1,
+            }
+        }
+
+        fn header(self) -> KeyPair<Box<dyn HeaderKey>> {
+            KeyPair {
+                local: Box::new(self),
+                remote: Box::new(self),
+            }
+        }
+
+        fn packet(self) -> KeyPair<Box<dyn PacketKey>> {
+            KeyPair {
+                local: Box::new(self),
+                remote: Box::new(self),
+            }
+        }
+
+        fn keys(self) -> Keys {
+            Keys {
+                header: self.header(),
+                packet: self.packet(),
+            }
+        }
+
+        fn checksum(self, packet: u64, slices: &[&[u8]]) -> u64 {
+            let mut hasher = SeaHasher::default();
+            if self.pn_bound {
+                hasher.write(&packet.to_le_bytes());
+            }
+            for slice in slices {
+                hasher.write(&(slice.len() as u64).to_le_bytes());
+                hasher.write(slice);
+            }
+            hasher.finish()
+        }
+    }
+
+    impl HeaderKey for CryptoKey {
+        fn decrypt(&self, _packet_number_offset: usize, _sample: &mut [u8]) {}
+        fn encrypt(&self, _packet_number_offset: usize, _sample: &mut [u8]) {}
+        fn sample_size(&self) -> usize {
+            0
+        }
+    }
+
+    impl PacketKey for CryptoKey {
+        fn encrypt(&self, packet: u64, buffer: &mut [u8], header_len: usize) {
+            let (header, body) = buffer.split_at_mut(header_len);
+            let (payload, tag) = body.split_at_mut(body.len() - self.tag_len());
+            tag.copy_from_slice(&self.checksum(packet, &[header, payload]).to_be_bytes());
+        }
+
+        fn decrypt(
+            &self,
+            packet: u64,
+            header: &[u8],
+            payload: &mut BytesMut,
+        ) -> Result<(), CryptoError> {
+            let tag = payload.split_off(payload.len() - self.tag_len()).get_u64();
+            if self.checksum(packet, &[header, payload]) != tag {
+                return Err(CryptoError);
+            }
+            Ok(())
+        }
+
+        fn tag_len(&self) -> usize {
+            8
+        }
+
+        fn confidentiality_limit(&self) -> u64 {
+            u64::MAX
+        }
+
+        fn integrity_limit(&self) -> u64 {
+            1 << 36
+        }
+    }
+
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    enum HandshakeState {
+        EmitInitial,
+        EmitHandshake,
+        Done,
+    }
+
+    #[derive(Debug)]
+    struct QuicSession {
+        side: Side,
+        key: CryptoKey,
+        state: HandshakeState,
+        local: TransportParameters,
+        remote: Option<TransportParameters>,
+    }
+
+    impl QuicSession {
+        fn new(side: Side, version: u32, params: TransportParameters) -> Self {
+            Self {
+                side,
+                key: CryptoKey::for_version(version),
+                state: HandshakeState::EmitInitial,
+                local: params,
+                remote: None,
+            }
+        }
+    }
+
+    impl Session for QuicSession {
+        fn initial_keys(&self, _destination: &ConnectionId, _side: Side) -> Keys {
+            self.key.keys()
+        }
+
+        fn handshake_data(&self) -> Option<Box<dyn Any>> {
+            self.remote.map(|params| Box::new(params) as _)
+        }
+
+        fn peer_identity(&self) -> Option<Box<dyn Any>> {
+            None
+        }
+
+        fn early_crypto(&self) -> Option<(Box<dyn HeaderKey>, Box<dyn PacketKey>)> {
+            None
+        }
+
+        fn early_data_accepted(&self) -> Option<bool> {
+            Some(false)
+        }
+
+        fn is_handshaking(&self) -> bool {
+            self.remote.is_none() || self.state != HandshakeState::Done
+        }
+
+        fn read_handshake(&mut self, mut buffer: &[u8]) -> Result<bool, TransportError> {
+            if self.remote.is_none() {
+                self.remote = Some(TransportParameters::read(self.side, &mut buffer)?);
+            }
+            Ok(true)
+        }
+
+        fn transport_parameters(&self) -> Result<Option<TransportParameters>, TransportError> {
+            Ok(self.remote)
+        }
+
+        fn write_handshake(&mut self, buffer: &mut Vec<u8>) -> Option<Keys> {
+            match self.state {
+                HandshakeState::EmitInitial => {
+                    if self.side.is_client() {
+                        self.local.write(buffer);
+                    }
+                    self.state = HandshakeState::EmitHandshake;
+                    Some(self.key.keys())
+                }
+                HandshakeState::EmitHandshake => {
+                    if self.side.is_server() {
+                        self.local.write(buffer);
+                    }
+                    self.state = HandshakeState::Done;
+                    Some(self.key.keys())
+                }
+                HandshakeState::Done => None,
+            }
+        }
+
+        fn next_1rtt_keys(&mut self) -> Option<KeyPair<Box<dyn PacketKey>>> {
+            Some(self.key.packet())
+        }
+
+        fn is_valid_retry(&self, _original: &ConnectionId, _header: &[u8], _payload: &[u8]) -> bool {
+            true
+        }
+
+        fn export_keying_material(
+            &self,
+            _output: &mut [u8],
+            _label: &[u8],
+            _context: &[u8],
+        ) -> Result<(), ExportKeyingMaterialError> {
+            Ok(())
+        }
+    }
+
+    #[derive(Debug)]
+    pub struct CryptoConfig;
+
+    impl ClientConfig for CryptoConfig {
+        fn start_session(
+            self: Arc<Self>,
+            version: u32,
+            _server_name: &str,
+            params: &TransportParameters,
+        ) -> Result<Box<dyn Session>, ConnectError> {
+            Ok(Box::new(QuicSession::new(Side::Client, version, *params)))
+        }
+    }
+
+    impl ServerConfig for CryptoConfig {
+        fn initial_keys(&self, version: u32, _destination: &ConnectionId) -> Result<Keys, UnsupportedVersion> {
+            Ok(CryptoKey::for_version(version).keys())
+        }
+
+        fn retry_tag(&self, _version: u32, _original: &ConnectionId, _packet: &[u8]) -> [u8; 16] {
+            [0; 16]
+        }
+
+        fn start_session(
+            self: Arc<Self>,
+            version: u32,
+            params: &TransportParameters,
+        ) -> Box<dyn Session> {
+            Box::new(QuicSession::new(Side::Server, version, *params))
+        }
+    }
+}
+
+pub fn transport_config() -> Arc<TransportConfig> {
+    let mut config = TransportConfig::default();
+    config
+        .max_concurrent_bidi_streams(u8::MAX.into())
+        .max_concurrent_uni_streams(0u8.into())
+        .keep_alive_interval(Some(Duration::from_secs(5)))
+        .initial_mtu(1200)
+        .min_mtu(1200)
+        .enable_segmentation_offload(true)
+        .congestion_controller_factory(Arc::new(BbrConfig::default()));
+    Arc::new(config)
+}
+
+pub fn server_config() -> ServerConfig {
+    let mut config = ServerConfig::with_crypto(Arc::new(crypto::CryptoConfig));
+    config.transport_config(transport_config());
+    config
+}
+
+pub fn client_config() -> ClientConfig {
+    let mut config = ClientConfig::new(Arc::new(crypto::CryptoConfig));
+    config.transport_config(transport_config());
+    config
+}
+
+pub fn etq1_client_config() -> ClientConfig {
+    let mut config = client_config();
+    config.version(QUIC_VERSION_ETQ1);
+    config
+}
+
+pub fn endpoint_config() -> EndpointConfig {
+    let mut config = EndpointConfig::default();
+    config.max_udp_payload_size(1200).unwrap();
+    config.supported_versions(vec![QUIC_VERSION_ETQ1, 1]);
+    config
+}
diff --git a/easytier-core/src/tunnel/mihomo_quic_session.rs b/easytier-core/src/tunnel/mihomo_quic_session.rs
new file mode 100644
index 0000000..532bcad
--- /dev/null
+++ b/easytier-core/src/tunnel/mihomo_quic_session.rs
@@ -0,0 +1,195 @@
+//! Adapt a core UDP session to Quinn's datagram socket contract.
+
+use std::{
+    fmt,
+    io::{self, IoSliceMut},
+    pin::Pin,
+    sync::{Arc, Mutex},
+    task::{Context, Poll},
+};
+
+use quinn::{AsyncUdpSocket, UdpPoller, udp::{RecvMeta, Transmit}};
+use tokio::sync::mpsc::{self, Receiver, Sender};
+use tokio_util::{sync::PollSender, task::AbortOnDropHandle};
+
+use crate::{
+    connectivity::transport::ConnectedUdpSession,
+    socket::udp::{UdpSession, UdpSessionSocket},
+};
+
+struct ReceivedDatagram {
+    payload: Vec<u8>,
+    dst_ip: Option<std::net::IpAddr>,
+}
+
+type SendBatch = Vec<Vec<u8>>;
+
+pub(crate) struct QuicUdpSessionSocket {
+    local_addr: std::net::SocketAddr,
+    peer_addr: std::net::SocketAddr,
+    incoming: Mutex<Receiver<io::Result<ReceivedDatagram>>>,
+    outgoing: Sender<SendBatch>,
+    _recv_task: AbortOnDropHandle<()>,
+    _send_task: AbortOnDropHandle<()>,
+    _session_guard: Box<dyn Send + Sync>,
+}
+
+impl fmt::Debug for QuicUdpSessionSocket {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.debug_struct("QuicUdpSessionSocket")
+            .field("local_addr", &self.local_addr)
+            .field("peer_addr", &self.peer_addr)
+            .finish_non_exhaustive()
+    }
+}
+
+impl QuicUdpSessionSocket {
+    pub(crate) fn new(connected: ConnectedUdpSession) -> io::Result<Self> {
+        let (session, guard) = connected.into_parts();
+        Self::from_session(Arc::new(session), guard)
+    }
+
+    pub(crate) fn from_accepted(
+        session: UdpSession,
+        guard: impl Send + Sync + 'static,
+    ) -> io::Result<Self> {
+        Self::from_session(Arc::new(session), Box::new(guard))
+    }
+
+    fn from_session(
+        session: Arc<dyn UdpSessionSocket>,
+        guard: Box<dyn Send + Sync>,
+    ) -> io::Result<Self> {
+        let local_addr = session.local_addr()?;
+        let peer_addr = session.peer_addr()?;
+        let (incoming_tx, incoming) = mpsc::channel(1024);
+        let (outgoing, mut outgoing_rx) = mpsc::channel::<SendBatch>(1024);
+        let recv_session = session.clone();
+        let recv_errors = incoming_tx.clone();
+        let recv_task = AbortOnDropHandle::new(tokio::spawn(async move {
+            let mut buffer = vec![0; 64 * 1024];
+            loop {
+                match recv_session.recv_with_meta(&mut buffer).await {
+                    Ok((len, meta)) => {
+                        if incoming_tx.send(Ok(ReceivedDatagram {
+                            payload: buffer[..len].to_vec(), dst_ip: meta.dst_ip,
+                        })).await.is_err() {
+                            break;
+                        }
+                    }
+                    Err(error) => {
+                        let _ = incoming_tx.send(Err(error)).await;
+                        break;
+                    }
+                }
+            }
+        }));
+        let send_task = AbortOnDropHandle::new(tokio::spawn(async move {
+            while let Some(batch) = outgoing_rx.recv().await {
+                for datagram in batch {
+                    let result = match session.send(&datagram).await {
+                        Ok(len) if len == datagram.len() => Ok(()),
+                        Ok(_) => Err(io::Error::new(io::ErrorKind::WriteZero, "QUIC UDP datagram partially sent")),
+                        Err(error) => Err(error),
+                    };
+                    if let Err(error) = result {
+                        let _ = recv_errors.send(Err(error)).await;
+                        return;
+                    }
+                }
+            }
+        }));
+        Ok(Self {
+            local_addr, peer_addr, incoming: Mutex::new(incoming), outgoing,
+            _recv_task: recv_task, _send_task: send_task, _session_guard: guard,
+        })
+    }
+
+    pub(crate) fn peer_addr(&self) -> std::net::SocketAddr {
+        self.peer_addr
+    }
+}
+
+struct Writable {
+    outgoing: PollSender<SendBatch>,
+}
+
+impl fmt::Debug for Writable {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("QuicSessionWritable")
+    }
+}
+
+impl UdpPoller for Writable {
+    fn poll_writable(mut self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<io::Result<()>> {
+        let result = self.outgoing.poll_reserve(context);
+        if matches!(result, Poll::Ready(Ok(_))) {
+            self.outgoing.abort_send();
+        }
+        result.map_err(|error| io::Error::new(io::ErrorKind::BrokenPipe, error))
+    }
+}
+
+impl AsyncUdpSocket for QuicUdpSessionSocket {
+    fn create_io_poller(self: Arc<Self>) -> Pin<Box<dyn UdpPoller>> {
+        Box::pin(Writable { outgoing: PollSender::new(self.outgoing.clone()) })
+    }
+
+    fn try_send(&self, transmit: &Transmit<'_>) -> io::Result<()> {
+        if transmit.destination != self.peer_addr {
+            return Err(io::Error::new(io::ErrorKind::AddrNotAvailable,
+                format!("QUIC session remote is {}, attempted {}", self.peer_addr, transmit.destination)));
+        }
+        let batch = match transmit.segment_size {
+            Some(0) => return Err(io::ErrorKind::InvalidInput.into()),
+            Some(segment) => transmit.contents.chunks(segment).map(<[u8]>::to_vec).collect(),
+            None => vec![transmit.contents.to_vec()],
+        };
+        self.outgoing.try_send(batch).map_err(|error| {
+            io::Error::new(match error {
+                mpsc::error::TrySendError::Full(_) => io::ErrorKind::WouldBlock,
+                mpsc::error::TrySendError::Closed(_) => io::ErrorKind::BrokenPipe,
+            }, "QUIC session send queue unavailable")
+        })
+    }
+
+    fn poll_recv(
+        &self,
+        context: &mut Context<'_>,
+        buffers: &mut [IoSliceMut<'_>],
+        metadata: &mut [RecvMeta],
+    ) -> Poll<io::Result<usize>> {
+        if buffers.is_empty() || metadata.is_empty() {
+            return Poll::Ready(Err(io::ErrorKind::InvalidInput.into()));
+        }
+        let mut receiver = self.incoming.lock().expect("QUIC session receive mutex poisoned");
+        loop {
+            match receiver.poll_recv(context) {
+                Poll::Ready(Some(Ok(packet))) => {
+                    if buffers[0].len() < packet.payload.len() {
+                        tracing::debug!(len = packet.payload.len(), capacity = buffers[0].len(),
+                            "drop oversized QUIC session datagram");
+                        continue;
+                    }
+                    buffers[0][..packet.payload.len()].copy_from_slice(&packet.payload);
+                    metadata[0] = RecvMeta {
+                        addr: self.peer_addr, len: packet.payload.len(), stride: packet.payload.len(),
+                        ecn: None, dst_ip: packet.dst_ip,
+                    };
+                    return Poll::Ready(Ok(1));
+                }
+                Poll::Ready(Some(Err(error))) => return Poll::Ready(Err(error)),
+                Poll::Ready(None) => return Poll::Ready(Err(io::ErrorKind::UnexpectedEof.into())),
+                Poll::Pending => return Poll::Pending,
+            }
+        }
+    }
+
+    fn local_addr(&self) -> io::Result<std::net::SocketAddr> {
+        Ok(self.local_addr)
+    }
+
+    fn may_fragment(&self) -> bool {
+        false
+    }
+}
