+}
+
+#[cfg(feature = "runtime-async-std")]
+// Due to MSRV, we must specify `self::` where there's crate/module ambiguity
+pub use self::async_std::AsyncStdRuntime;
+
+#[cfg(feature = "runtime-async-std")]
+mod async_std {
