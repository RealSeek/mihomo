@@ -0,0 +1,39 @@
+//! Public IPv6 address reservations use the same live host observations as
+//! underlay connection selection.
+
+use std::{collections::HashSet, net::Ipv6Addr, sync::Arc};
+
+use cidr::Ipv6Cidr;
+
+use crate::{
+    connectivity::composite::ConnectorRuntime,
+    peers::public_ipv6::PublicIpv6Host,
+    socket::SocketContext,
+};
+
+pub struct WasiHostPublicIpv6<R> {
+    runtime: Arc<R>,
+}
+
+impl<R> WasiHostPublicIpv6<R> {
+    pub fn new(runtime: Arc<R>) -> Self {
+        Self { runtime }
+    }
+}
+
+#[async_trait::async_trait]
+impl<R> PublicIpv6Host for WasiHostPublicIpv6<R>
+where
+    R: ConnectorRuntime,
+{
+    async fn collect_reserved_public_ipv6_addrs(&self, prefix: Ipv6Cidr) -> HashSet<Ipv6Addr> {
+        let addresses = self.runtime.collect_ip_addrs(&SocketContext::default()).await;
+        addresses
+            .interface_ipv6s
+            .into_iter()
+            .chain(addresses.public_ipv6)
+            .map(Ipv6Addr::from)
+            .filter(|address| prefix.contains(address))
+            .collect()
+    }
+}
