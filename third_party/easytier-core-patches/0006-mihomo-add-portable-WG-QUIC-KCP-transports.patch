+        Ok(Self {
+            last_send_error: Mutex::new(now.checked_sub(2 * IO_ERROR_LOG_INTERVAL).unwrap_or(now)),
+            max_gso_segments: AtomicUsize::new(gso::max_gso_segments()),
+            gro_segments: gro::gro_segments(),
+            may_fragment,
+            sendmsg_einval: AtomicBool::new(false),
